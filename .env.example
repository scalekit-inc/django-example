# Scalekit OAuth 2.0 / OIDC Configuration
# Get these values from your Scalekit dashboard: https://app.scalekit.com
SCALEKIT_ENV_URL=https://your-env.scalekit.io
SCALEKIT_CLIENT_ID=YOUR_CLIENT_ID
SCALEKIT_CLIENT_SECRET=YOUR_CLIENT_SECRET
SCALEKIT_REDIRECT_URI=http://localhost:8000/auth/callback
# Note: No trailing slash in redirect URI to avoid session state issues

# Optional Django Configuration
# DEBUG=True
# ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_SECRET_KEY=your-secret-key-here  # Optional: Django will use a default for local dev

